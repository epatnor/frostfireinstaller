# ujust recipe for Bazzite / universal-blue images.
#
# Add this file to your image's justfile (e.g. ublue-os/bazzite), then users run:
#   ujust install-frostylauncher

install-frostylauncher:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Installerar frostylauncher (Battle.net + WoW via umu + Proton) ..."
    curl -fsSL https://raw.githubusercontent.com/OWNER/frostylauncher/main/packaging/install.sh | bash
    echo "Klart. Kör 'frostylauncher doctor' eller 'frostylauncher gui'."
