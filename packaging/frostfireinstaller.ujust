# ujust recipe for Bazzite / universal-blue images.
#
# Add this file to your image's justfile (e.g. ublue-os/bazzite), then users run:
#   ujust install-frostfireinstaller

install-frostfireinstaller:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Installing frostfireinstaller (Battle.net + WoW via umu + Proton) ..."
    curl -fsSL https://raw.githubusercontent.com/epatnor/frostfireinstaller/main/packaging/install.sh | bash
    echo "Done. Run 'frostfireinstaller doctor' or 'frostfireinstaller gui'."
