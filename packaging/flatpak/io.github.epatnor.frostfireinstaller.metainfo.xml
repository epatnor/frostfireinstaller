<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.epatnor.frostfireinstaller</id>
  <name>Frostfire Installer</name>
  <summary>Install and launch Blizzard games on Linux</summary>
  <developer id="io.github.epatnor">
    <name>Patrik Nordlund</name>
  </developer>
  <description>
    <p>
      Frostfire Installer is a reliable, idempotent way to run Blizzard games
      (World of Warcraft, Diablo, Overwatch, Hearthstone and more) on Linux.
    </p>
    <p>
      It drives umu-launcher together with a Proton build and manages a
      dedicated Wine prefix, with logging, system checks, recommendations and
      self-healing. Games are started from Blizzard's own Battle.net launcher;
      this app is the helper underneath.
    </p>
  </description>
  <launchable type="desktop-id">io.github.epatnor.frostfireinstaller.desktop</launchable>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <categories>
    <category>Game</category>
    <category>Utility</category>
  </categories>
  <url type="homepage">https://github.com/epatnor/frostfireinstaller</url>
  <url type="bugtracker">https://github.com/epatnor/frostfireinstaller/issues</url>
  <url type="vcs-browser">https://github.com/epatnor/frostfireinstaller</url>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/epatnor/frostfireinstaller/main/assets/screenshots/main.png</image>
      <caption>The compact main window</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/epatnor/frostfireinstaller/main/assets/screenshots/advanced.png</image>
